# 环境标识（dev 或 prod）
ENVIRONMENT=dev

# WebSocket 服务监听地址和端口（与 NapCat 配置的 ws 地址保持一致）
HOST=127.0.0.1
PORT=8080

# 日志级别
LOG_LEVEL=INFO

# 超级用户（你的 QQ 号，多个用逗号分隔）
SUPERUSERS=["123456789"]

# 命令前缀（支持多个，这里设置 / 和 空 两种）
COMMAND_START=["/", ""]

# Windows 下建议关闭热重载，避免卡死
FASTAPI_RELOAD=false

# 你自己的 API Key 和配置
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_MODEL=deepseek-chat
PIXIV_REFRESH_TOKEN=你的refresh_token

# 智谱 AI
ZHIPU_API_KEY=5a3347abc3e442e08eba0ff1ba0da824.uEm470rD2Qe4QYMr
ZHIPU_MODEL=glm-4.7-flash
ENABLE_THINKING=false   # 是否需要深度思考模式（默认关闭，节省 token）