DRIVER=~fastapi
# 环境标识（dev 或 prod）
ENVIRONMENT=prod

# WebSocket 服务监听地址和端口（与 NapCat 配置的 ws 地址保持一致）
HOST=127.0.0.1
PORT=8080

# 日志级别
LOG_LEVEL=INFO

ADMIN_QQ_LIST=2949189128

# 命令前缀（支持多个，这里设置 / 和 空 两种）
COMMAND_START=["/", ""]

# Windows 下建议关闭热重载，避免卡死
FASTAPI_RELOAD=false

# LongCat API Key（从平台获取）
LONGCAT_API_KEY=ak_2q362z4tr6Yw9mn4C83ob8Fx6Ti8G

#jm_pwd="kknb"
jm_forward=True
jm_lock=True
jm_lock_size=1

# Pixiv 插件配置
pixiv_refresh_token=4WqskzDYbxIs8Wju6oX144ZP2nnV1pT2SzpN4SMBv9M
pixiv_admin_qq=2949189128  # 你的QQ号，用于手动刷新token命令
napcat_temp_dir=D:\QQFiles\NapCat\temp  # NapCat临时目录
pixiv_cooldown_seconds=45   # 可选，默认45秒
pixiv_recall_seconds=45     # 可选，默认45秒
pixiv_whitelist_users=2949189128  # 可选，白名单QQ号（多个用逗号分隔）

PIXIV_WHITELIST_GROUPS=704877596

SAUCENAO_API_KEY=d63e8bcd770710e6726da70001855d3fb6a046e5
ZHIPU_API_KEY = 70f047de5f7f4fb8b8f9bf45cf9d4f31.bSFwkMbWvnN6kWOc