DRIVER=~fastapi
# 环境标识（dev 或 prod）
ENVIRONMENT=prod

# WebSocket 服务监听地址和端口（与 NapCat 配置的 ws 地址保持一致）
HOST=127.0.0.1
PORT=8080

# 日志级别
LOG_LEVEL=INFO

ADMIN_QQ_LIST=

# 命令前缀（支持多个，这里设置 / 和 空 两种）
COMMAND_START=["/", ""]

# Windows 下建议关闭热重载，避免卡死
FASTAPI_RELOAD=false

# LongCat API Key（从平台获取）
LONGCAT_API_KEY=

#jm_pwd="kknb"
jm_forward=True
jm_lock=True
jm_lock_size=1

# Pixiv 插件配置
pixiv_refresh_token=
pixiv_admin_qq=  # 你的QQ号，用于手动刷新token命令
napcat_temp_dir=D:\QQFiles\NapCat\temp  # NapCat临时目录
pixiv_cooldown_seconds=45   # 可选，默认45秒
pixiv_recall_seconds=45     # 可选，默认45秒
pixiv_whitelist_users=  # 可选，白名单QQ号（多个用逗号分隔）

PIXIV_WHITELIST_GROUPS=

SAUCENAO_API_KEY=
ZHIPU_API_KEY =
